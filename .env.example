# Puerto del servidor
PORT=3000

# Datos del Corralón / Distribuidora
STORE_NAME="Corralón & Distribuidora Norte"
STORE_TAGLINE="Materiales de Construcción • Venta Mayorista y Minorista"
STORE_LOGO="" # Dejar vacío para usar el logo generado o poner URL/ruta
PRIMARY_COLOR="#f97316" # Color principal (hex)
SECONDARY_COLOR="#0f172a"

# WhatsApp destino para recibir los pedidos (formato internacional sin +)
# Argentina: 549 + código de área + número (ej. 5491123456789)
WHATSAPP_PHONE="5491123456789"

# Contraseña para acceder a /admin
ADMIN_PASSWORD="admin123"

# Reglas comerciales y horarios
MIN_ORDER_AMOUNT=15000
BUSINESS_OPEN_TIME="08:00"
BUSINESS_CLOSE_TIME="18:00"
BUSINESS_SATURDAY_CLOSE_TIME="13:00"
BUSINESS_HOURS_TEXT="Lun a Vie 08:00 a 18:00 | Sáb 08:00 a 13:00"

# Ruta del archivo SQLite (en Render con Persistent Disk podés usar /data/pedidos.db)
DATABASE_PATH="./pedidos.db"
